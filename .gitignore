# Never commit data or results
data/
results/
*.fdt
*.set
*.sif

# Slurm logs (keep the folder)
slurm/logs/*
!slurm/logs/.gitkeep

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.venv-normal/
runtime-dependencies/
test-dependencies/
.pytest_cache/
experiments/
logs/
preprocessed_data/
preprocessed_ec_eo/
*.npz
*.npy
*.pt
*.joblib

# LaTeX build files (paper/); figures are kept as PDF only
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/main.pdf
paper/figures/*.png
